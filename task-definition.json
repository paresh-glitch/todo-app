{
  "family": "todo-app",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::YOUR_ACCOUNT_ID:role/ecsTaskExecutionRole",

  "containerDefinitions": [

    {
      "name": "mongodb",
      "image": "YOUR_ACCOUNT_ID.dkr.ecr.ap-south-1.amazonaws.com/todo-mongodb:latest",

      "command": ["mongod", "--wiredTigerCacheSizeGB", "0.25"],

      "portMappings": [
        { "containerPort": 27017, "protocol": "tcp" }
      ],

      "memory": 300,
      "cpu": 100,

      "healthCheck": {
        "command": ["CMD", "mongosh", "--eval", "db.adminCommand('ping')"],
        "interval": 15,
        "timeout": 5,
        "retries": 5,
        "startPeriod": 30
      },

      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/todo-app",
          "awslogs-region": "ap-south-1",
          "awslogs-stream-prefix": "mongodb"
        }
      }
    },

    {
      "name": "backend",
      "image": "YOUR_ACCOUNT_ID.dkr.ecr.ap-south-1.amazonaws.com/todo-backend:latest",

      "portMappings": [
        { "containerPort": 5000, "protocol": "tcp" }
      ],

      "environment": [
        {
          "name": "MONGO_URI",
          "value": "mongodb://127.0.0.1:27017/tododb"
        },
        {
          "name": "PORT",
          "value": "5000"
        }
      ],

      "memory": 256,
      "cpu": 156,

      "dependsOn": [
        {
          "containerName": "mongodb",
          "condition": "HEALTHY"
        }
      ],

      "healthCheck": {
        "command": ["CMD-SHELL", "wget -qO- http://127.0.0.1:5000/health || exit 1"],
        "interval": 15,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 20
      },

      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/todo-app",
          "awslogs-region": "ap-south-1",
          "awslogs-stream-prefix": "backend"
        }
      }
    },

    {
      "name": "frontend",
      "image": "YOUR_ACCOUNT_ID.dkr.ecr.ap-south-1.amazonaws.com/todo-frontend:latest",

      "portMappings": [
        { "containerPort": 80, "protocol": "tcp" }
      ],

      "memory": 128,
      "cpu": 100,

      "dependsOn": [
        {
          "containerName": "backend",
          "condition": "HEALTHY"
        }
      ],

      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/todo-app",
          "awslogs-region": "ap-south-1",
          "awslogs-stream-prefix": "frontend"
        }
      }
    }

  ]
}
